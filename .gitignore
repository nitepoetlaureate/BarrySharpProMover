# build artefacts
/builds/
/out/
/dist/
/*.pocket

# local IDE caches
.vscode/
.idea/

# Node
node_modules/

# OS cruft
.DS_Store

# GB Studio autosaves
*.gbsproj.bak

# Optional: Git LFS will handle these
*.png
*.mod
*.wav
assets.bak/
*.swp

# Python virtual environments and packages (CRITICAL - prevents 1.6GB bloat!)
langflow/          # Duplicate langflow source (should use pip-installed version)
langflow_repo/     # Cloned langflow repository
langflow_env/      # Virtual environment for langflow
venv/              # Project virtual environment
env/
ENV/
*.egg-info/        # Python package metadata
*.egg

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/
