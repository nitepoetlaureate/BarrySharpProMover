# BarrySharpProMover Environment Configuration
# =============================================
# Copy this file to .env and configure for your environment
# DO NOT commit .env to version control!
#
# Setup instructions:
# 1. cp .env.example .env
# 2. Edit .env and set your GB Studio CLI path
# 3. Run: python3 scripts/validate_env.py
# 4. Run: make check-gbstudio

# ======================================
# GB Studio Configuration (REQUIRED)
# ======================================

# Path to GB Studio CLI
# Find with:
#   macOS:   find /Applications/GB\ Studio.app -name gb-studio-cli.js
#   Linux:   which gb-studio-cli || find /opt /usr/local -name gb-studio-cli.js
#   Windows: where gb-studio-cli.js
#
# Example paths:
#   macOS:   /Applications/GB Studio.app/Contents/Resources/app/out/cli/gb-studio-cli.js
#   Linux:   /opt/gb-studio/out/cli/gb-studio-cli.js
#   Windows: C:/Program Files/GB Studio/resources/app/out/cli/gb-studio-cli.js
GB_STUDIO_CLI_PATH=/path/to/gb-studio/out/cli/gb-studio-cli.js

# ======================================
# LangFlow Configuration
# ======================================

# LangFlow server settings
LANGFLOW_PORT=7860
LANGFLOW_HOST=127.0.0.1

# Auto-start LangFlow on automation start
LANGFLOW_AUTO_START=true

# ======================================
# RAG System Configuration
# ======================================

# Ollama server URL (must be running for RAG features)
# Install Ollama: https://ollama.ai
OLLAMA_HOST=http://localhost:11434

# Embedding model for vector storage
# Pull with: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# LLM model for RAG responses
# Pull with: ollama pull mistral
LLM_MODEL=mistral

# Vector store directory
VECTOR_STORE_DIR=vectorstore

# ======================================
# Build Configuration
# ======================================

# Build output directory
BUILD_DIR=build

# ROM output filename
ROM_NAME=game.gb

# Enable debug mode for verbose build output
DEBUG_MODE=false

# ======================================
# Automation Configuration
# ======================================

# Auto-run tests after build
AUTO_TEST=true

# File watcher debounce time (seconds)
FILE_WATCHER_DEBOUNCE=5

# Enable approval queue for automated builds
APPROVAL_QUEUE_ENABLED=true

# ======================================
# Validation Configuration
# ======================================

# Maximum background tiles (GB limit is 192)
MAX_BG_TILES=192

# Maximum sprites per scene
MAX_SPRITES_PER_SCENE=20

# Maximum actors per scene
MAX_ACTORS_PER_SCENE=10

# ======================================
# Notification Configuration (Optional)
# ======================================

# Enable notifications
NOTIFICATIONS_ENABLED=false

# Email notifications
NOTIFY_EMAIL=

# Slack webhook for build notifications
NOTIFY_SLACK_WEBHOOK=

# Discord webhook for build notifications
NOTIFY_DISCORD_WEBHOOK=

# ======================================
# API Keys (SENSITIVE - DO NOT COMMIT)
# ======================================

# Google API key for integrations
GOOGLE_API_KEY=

# GitHub token for automation
GITHUB_TOKEN=

# OpenAI API key (if using OpenAI models)
OPENAI_API_KEY=

# ======================================
# Development Options
# ======================================

# Python log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable development mode features
DEV_MODE=false

# Project root (auto-detected if not set)
PROJECT_ROOT=

# Enable verbose output
VERBOSE=false

# ======================================
# Testing Configuration
# ======================================

# Run tests in CI mode (no interactive prompts)
CI_MODE=false

# Test timeout in seconds
TEST_TIMEOUT=300

# Enable test coverage reporting
COVERAGE_ENABLED=false

# ======================================
# Security Configuration
# ======================================

# Enable security scanning (runs safety check on dependencies)
SECURITY_SCAN_ENABLED=false

# Allowed file extensions for uploads
ALLOWED_EXTENSIONS=.png,.jpg,.wav,.gb,.json,.md

# Maximum file size for uploads (bytes) - 10MB default
MAX_FILE_SIZE=10485760

# Path traversal protection (reject absolute paths)
REJECT_ABSOLUTE_PATHS=true

# Enable input sanitization for all user inputs
INPUT_SANITIZATION_ENABLED=true

# Maximum JSON nesting depth (prevents DoS via deeply nested JSON)
MAX_JSON_DEPTH=10

# Maximum string length for user inputs
MAX_INPUT_LENGTH=10000

# Enable strict filename validation
STRICT_FILENAME_VALIDATION=true

# Allowed base directories for file operations (comma-separated)
# If empty, uses project root and standard asset directories
ALLOWED_BASE_DIRECTORIES=

# Security headers for web components (if applicable)
SECURITY_HEADERS_ENABLED=true

# Enable command injection protection
COMMAND_INJECTION_PROTECTION=true

# ======================================
# Performance Configuration
# ======================================

# Number of parallel build jobs
BUILD_JOBS=1

# Enable build caching
BUILD_CACHE_ENABLED=true

# Cache directory
CACHE_DIR=.cache
